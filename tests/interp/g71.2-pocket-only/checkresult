#!/usr/bin/env python3
"""G71.2 must cut pockets that are no longer connected to the Z0 face."""
import re
import sys

text = open(sys.argv[1] if len(sys.argv) > 1 else "result").read()
if "STRAIGHT_FEED" not in text:
    print("no STRAIGHT_FEED in output")
    sys.exit(1)
feeds = []
for m in re.finditer(
        r"STRAIGHT_FEED\(([-\d.]+),\s*[-\d.]+,\s*([-\d.]+)", text):
    feeds.append((float(m.group(1)), float(m.group(2))))
# G71.1 only cuts the outer envelope, above the groove.  Its passes land
# on X=11, 10, ...; G71.2 drops that envelope interval every level.
if not any(x > 10.4 for x, z in feeds):
    print("no envelope feed from G71.1 (want X>10.4); feeds=%s" % feeds[:8])
    sys.exit(1)
# Only G71.2 can reach the groove bottom, below X=5.
if not any(x < 5.0 for x, z in feeds):
    print("G71.2 did not cut the pocket (no feed below X=5); feeds=%s"
          % feeds[-8:])
    sys.exit(1)
sys.exit(0)
