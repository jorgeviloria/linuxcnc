#!/bin/bash
set -e
result=${1:-result}
grep -q 'STRAIGHT_FEED' "$result" || {
    echo "no STRAIGHT_FEED in output"
    exit 1
}
# The scan must use the real bottom of the arc (X ~ 3.9), not only the arc
# end points at X=10, so a pass reaches X=4.
if ! grep -q 'STRAIGHT_FEED(4.0000' "$result"; then
    echo "no roughing feed at X=4: arc bottom was not reached"
    exit 1
fi
exit 0
