#!/usr/bin/env python3
"""G71.3 then G70.3: roughing feeds and a finish pass that reaches the profile."""
import re
import sys

text = open(sys.argv[1] if len(sys.argv) > 1 else "result").read()
if "STRAIGHT_FEED" not in text:
    print("no STRAIGHT_FEED in output")
    sys.exit(1)
feeds = []
for m in re.finditer(
        r"STRAIGHT_FEED\(([-\d.]+),\s*[-\d.]+,\s*([-\d.]+)", text):
    feeds.append((float(m.group(1)), float(m.group(2))))
# Finish allowance U1 (radius in G8) so roughing stays off X=6; G70.3 should
# still feed at the finished profile.
if not any(abs(x - 6.0) < 1e-3 and abs(z + 10.0) < 1e-3 for x, z in feeds):
    print("G70.3 finish pass did not feed X=6 Z=-10; feeds=%s" % feeds[-8:])
    sys.exit(1)
if "12.0000" not in text:
    print("no return toward start X=12")
    sys.exit(1)
sys.exit(0)
