#!/usr/bin/env python3
"""One-line G71.3 Type I: roughing feeds at stepped X, including the profile."""
import re
import sys

text = open(sys.argv[1] if len(sys.argv) > 1 else "result").read()
if "STRAIGHT_FEED" not in text:
    print("no roughing STRAIGHT_FEED in output")
    sys.exit(1)
feeds = []
for m in re.finditer(
        r"STRAIGHT_FEED\(([-\d.]+),\s*[-\d.]+,\s*([-\d.]+)", text):
    feeds.append((float(m.group(1)), float(m.group(2))))
xs = {round(x, 4) for x, z in feeds}
if 6.0 not in xs:
    print("expected a roughing feed at profile X=6, got %s" % sorted(xs))
    sys.exit(1)
if not any(abs(z + 10.0) < 1e-3 for x, z in feeds):
    print("expected a feed reaching Z=-10")
    sys.exit(1)
sys.exit(0)
