#!/bin/bash
set -e
result=${1:-result}
grep -q STRAIGHT_FEED "$result" || { echo "no STRAIGHT_FEED"; exit 1; }
grep -q 'STRAIGHT_FEED(6.0000' "$result" || {
    echo "#100=[#100+1] between G71.3 and N(P) was not visible to the profile (want X=6)"
    exit 1
}
# After the cycle, #100=[#100+1] must run once on the restored 5 → 6.
# Without rollback the scan would leave #100=6 and the same line would yield 7.
if ! grep -E -q 'STRAIGHT_TRAVERSE\(6\.0000.*, *50\.0000' "$result"; then
    echo "expected TRAVERSE to X=6 Z=50 after the cycle (rollback + one +1)"
    if grep -E -q 'STRAIGHT_TRAVERSE\(7\.0000.*, *50\.0000' "$result"; then
        echo "got X=7 Z=50: #100=[#100+1] ran twice (no parameter rollback)"
    fi
    exit 1
fi
grep -q -- '-10.0000' "$result" || {
    echo "Z#101=-10 was not applied in the profile"
    exit 1
}
# #102=[#102+1] is inside P-Q: skip must not store it. Live #102 stays 20.
if ! grep -E -q 'STRAIGHT_TRAVERSE\(20\.0000.*, *51\.0000' "$result"; then
    echo "expected TRAVERSE to X=20 Z=51 (#102 inside P-Q must not persist)"
    if grep -E -q 'STRAIGHT_TRAVERSE\(21\.0000.*, *51\.0000' "$result"; then
        echo "got X=21 Z=51: skipped #102=[#102+1] was applied to live parameters"
    fi
    exit 1
fi
exit 0
