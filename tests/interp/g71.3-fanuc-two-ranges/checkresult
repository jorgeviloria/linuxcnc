#!/usr/bin/env python3
"""Two P/Q ranges in one program: the older G70.3 falls back to a search,
the newest one reuses the range G71.3 cached."""
import re
import sys

text = open(sys.argv[1] if len(sys.argv) > 1 else "result").read()
if "STRAIGHT_FEED" not in text:
    print("no STRAIGHT_FEED in output")
    sys.exit(1)
feeds = []
for m in re.finditer(
        r"STRAIGHT_FEED\(([-\d.]+),\s*[-\d.]+,\s*([-\d.]+)", text):
    feeds.append((float(m.group(1)), float(m.group(2))))


def has(x, z):
    return any(abs(fx - x) < 0.01 and abs(fz - z) < 0.01 for fx, fz in feeds)


# The finishing passes trace the exact profile; the roughing passes stop
# 1.0 (U) above it, so these points only come from the matching G70.3.
if not has(6.0, -10.0):
    print("G70.3 P10 Q20 did not finish part 1 (want X=6 Z=-10); feeds=%s"
          % feeds[-10:])
    sys.exit(1)
if not has(10.0, -15.0):
    print("G70.3 P30 Q40 did not finish part 2 (want X=10 Z=-15); feeds=%s"
          % feeds[-10:])
    sys.exit(1)
sys.exit(0)
