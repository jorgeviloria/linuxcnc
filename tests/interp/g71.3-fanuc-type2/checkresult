#!/usr/bin/env python3
"""Type II pocket: feeds into the groove at X=6 and along Z to -16."""
import re
import sys

text = open(sys.argv[1] if len(sys.argv) > 1 else "result").read()
if "STRAIGHT_FEED" not in text:
    print("no roughing STRAIGHT_FEED in output")
    sys.exit(1)
feeds = []
for m in re.finditer(
        r"STRAIGHT_FEED\(([-\d.]+),\s*[-\d.]+,\s*([-\d.]+)", text):
    feeds.append((float(m.group(1)), float(m.group(2))))
xs = {round(x, 4) for x, z in feeds}
zs = {round(z, 4) for x, z in feeds}
if 6.0 not in xs:
    print("expected pocket feed at X=6, got X=%s" % sorted(xs))
    sys.exit(1)
if -16.0 not in zs and not any(abs(z + 16.0) < 1e-3 for x, z in feeds):
    print("expected a feed reaching Z=-16, got Z=%s" % sorted(zs))
    sys.exit(1)
sys.exit(0)
